# Copy to .env.local for local dev. Never commit the real values.

DATABASE_URL=

# Human login password for /admin (checked server-side).
ADMIN_PASSWORD=

# Secret bearer key for scripted/agent access to the content API
# (app/api/essays, /api/pages, /api/featured). Sent as the x-api-key header.
ADMIN_API_KEY=

# --- Talk to Mr. Poppin (/talk-to-mr-poppin, /api/ai/query) ---
# Primary model provider (Anthropic Claude). Prefer this in production.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5 (current mid-tier Sonnet per Anthropic docs).
ANTHROPIC_MODEL=

# Optional OpenAI fallback if ANTHROPIC_API_KEY is unset.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# --- Reader auth (Google + email magic link). Separate from admin. ---
# Required for signed cookies, Auth.js sessions, and anonymous quota cookies.
AUTH_SECRET=

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend API key for magic-link email (https://resend.com)
AUTH_RESEND_KEY=
# From address on a Resend-verified domain, e.g. "Mr. Poppin <hello@theprolificpoppin.com>"
# For local testing you can use Resend's onboarding@resend.dev sender.
AUTH_EMAIL_FROM=

# Optional. Auth.js also accepts AUTH_URL (canonical site URL).
# AUTH_URL=https://www.theprolificpoppin.com
